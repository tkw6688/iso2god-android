<?xml version="1.0" encoding="utf-8"?>
<!--
  English translation. The default (values/strings.xml) is Chinese, so devices
  set to any other language fall back to Chinese unless a matching values-xx/
  directory exists. Keep the key set identical to the default file.
-->
<resources>
    <string name="app_name">ISO2GOD</string>

    <!-- 状态卡 -->
    <string name="status_select_iso">Select an ISO file to convert</string>
    <string name="status_analyzing">Analyzing ISO file…</string>
    <string name="status_analyzed">ISO analyzed</string>
    <string name="status_read_error">Failed to read ISO: %1$s</string>
    <string name="status_preparing">Preparing to convert…</string>
    <string name="status_converting">Converting ISO to GOD format…</string>
    <string name="status_convert_error">Conversion error: %1$s</string>
    <string name="status_create_output_dir_failed">Could not create the output directory</string>
    <string name="status_create_header_failed">Could not create the header file or data directory</string>

    <!-- 进度卡 -->
    <string name="progress_card_title">Progress</string>
    <string name="progress_init">Initializing…</string>
    <string name="progress_creating_parts">Creating data parts (%1$d)…</string>
    <string name="progress_writing_part">Writing data part %1$d/%2$d…</string>
    <string name="progress_writing_mht">Computing MHT hash chain…</string>
    <string name="progress_writing_header">Writing header…</string>
    <string name="progress_done">Finished</string>
    <string name="progress_aborted">Interrupted</string>

    <!-- 转换结果：失败时拼成「前缀：原因（诊断细节）」，detail 为空则省略括号部分 -->
    <string name="result_success">Conversion complete!</string>
    <string name="failure_prefix_analyze">Analysis failed</string>
    <string name="failure_prefix_convert">Conversion failed</string>
    <string name="failure_format">%1$s: %2$s</string>
    <string name="failure_format_detail">%1$s: %2$s (%3$s)</string>

    <!-- 失败原因，code 见 android-bridge 的 ErrorCode -->
    <string name="error_jni">Native library call failed</string>
    <string name="error_iso_read">Cannot read the ISO (not a valid Xbox 360 image?)</string>
    <string name="error_part_count_mismatch">Data part count does not match the ISO</string>
    <string name="error_write_part">Failed to write a data part</string>
    <string name="error_mht">Failed to write the MHT hash chain</string>
    <string name="error_header">Failed to write the header</string>
    <string name="error_unknown">Unknown error</string>

    <!-- 转换途中抛出、最终会被展示给用户的异常 -->
    <string name="error_create_part">Could not create data part %1$d</string>
    <string name="error_open_part">Could not open data part %1$d</string>

    <!-- 游戏信息卡 -->
    <string name="info_card_title">Game Info</string>
    <string name="label_name">Title</string>
    <string name="label_title_id">Title ID</string>
    <string name="label_media_id">Media ID</string>
    <string name="label_size">Size</string>
    <string name="label_data_parts">Data parts</string>
    <string name="title_unknown">Unknown (not in title list)</string>
    <string name="size_gb">%1$.2f GB</string>

    <!-- 操作按钮 -->
    <string name="action_select_iso">Select ISO</string>
    <string name="action_start_conversion">Start conversion</string>

    <!-- 开源许可 -->
    <string name="licenses_title">Open source licenses</string>
    <string name="licenses_intro">This app (ISO2GOD Android) is released under the MIT License. The license notices for the third-party components distributed with it are listed below:</string>
    <string name="action_close">Close</string>
</resources>
